{:paths ["src"]
 ;; Built on langgraph-clj (graph agent loop) which brings langchain-clj
 ;; (ChatModel / tools / Datomic-API store). Both are zero-third-party-dep .cljc.
 :deps {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error {:git/sha "838dec56c9a5b74f9eec825a2fb28bda157f8cd3"}
        ;; kotoba.http.form-urlencoded replaced java.net.URLEncoder/URLDecoder here
        ;; (2026-09-24). An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/http-parse-url {:git/sha "8ad2f9680111e50168b4078a64601dc9296158d7"}
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.lang.coll replaced clojure.walk here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll's walk rebuilds real map entries from e88106f,
        ;; and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "f74e248f0a07e8ae572885f50fab6bdb39dc24be"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
         :git/sha "577a59a9d5eb3ef90b81342f4673973f481ff7f4"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; local checkouts for workspace development (orgs/kotoba-lang/*)
  :dev {:override-deps {io.github.kotoba-lang/langgraph
                        {:local/root "../langgraph"}
                        io.github.kotoba-lang/langchain
                        {:local/root "../langchain"}}}
  ;; JVM Cloud API transport and the safe live probe. The portable client keeps
  ;; HTTP/JSON injected; this alias is the concrete java.net.http host.
  :cloud {:extra-paths ["examples" "test-cloud"]
          :extra-deps {cheshire/cheshire {:mvn/version "5.13.0"}}}
  ;; Real browser via Playwright — used by examples/yoro_visual_test.cljk live mode
  ;; Model: Murakumo LiteLLM 127.0.0.1:4000 (ADR-2605215000 Murakumo-only invariant)
  ;; Fallback (Murakumo down): Ollama 127.0.0.1:11434 local inference
  :playwright {:extra-paths ["examples" "test-playwright"]
               :extra-deps {com.microsoft.playwright/playwright {:mvn/version "1.44.0"}
                            clj-http/clj-http                  {:mvn/version "3.13.0"}
                            cheshire/cheshire                  {:mvn/version "5.13.0"}}}
  ;; Production CapSolver JVM transport. Portable adapter/tests stay zero-dep.
  :capsolver {:extra-paths ["examples"]
              :extra-deps {cheshire/cheshire {:mvn/version "5.13.0"}}}
  :playwright-probe {:extra-deps {com.microsoft.playwright/playwright {:mvn/version "1.44.0"}}
                     :main-opts ["-m" "browseruse.playwright-probe"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "test-cloud"
                     "--fail-level" "error"]}}}
